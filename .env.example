# Copy to `.env` for local dev and fill in real values. Never commit `.env`.
#
# Vercel deploy: add every var below EXCEPT GOOGLE_API_KEY to the project's
# Environment Variables (Production + Preview). VITE_* are baked in at build
# time, so redeploy after changing them.

# ---- Frontend (Vite) — safe to expose to the browser ----
# Supabase project URL and the publishable/anon key (NOT the service key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Server (API routes) — NEVER expose these to the browser ----
# Supabase service-role key (bypasses RLS; server only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic API key for AI plan generation.
ANTHROPIC_API_KEY=sk-ant-...

# Notion integration token and the clients (intake/applications) database ID.
NOTION_API_KEY=ntn_...
NOTION_DATABASE_ID=your-notion-database-id
# Notion program library database ID — templates whose session structure (Primary
# Strength, Secondary Strength, Accessories, Finishers, Circuits, Core) frames AI
# program generation. Share this database with the integration too.
NOTION_PROGRAM_LIBRARY_DB_ID=your-program-library-database-id
# The "V12 Lead Pipeline — CRM" database's data source ID (NOT the database ID —
# this database uses Notion's multi-source-database format; a "database" is a
# container, properties/pages live on its "data source"). Find it via the API
# (GET /v1/databases/{database_id} with Notion-Version 2025-09-03 returns a
# data_sources array) or ask the coach for it directly. Share this database
# with the integration too.
NOTION_CRM_DATA_SOURCE_ID=your-crm-data-source-id

# ---- Local scripts only — NOT needed on Vercel ----
# Google Sheets API key, used only by scripts/migrate-checkins-sheet.js.
GOOGLE_API_KEY=your-google-api-key
